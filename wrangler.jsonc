{
  "$schema": "./node_modules/wrangler/config-schema.json",

  "name": "biscotti-site",

  "main": "./worker/index.js",

  "compatibility_date": "2026-09-28",

  "vars": {
    "SHOPIFY_STORE_DOMAIN": "ktmc3u-qx.myshopify.com",

    "WHOLESALE_NOTIFICATION_EMAIL": "contact@cadagnolo.com",

    "WHOLESALE_FROM_EMAIL": "Cadagnolo's Kitchen <wholesale@cadagnolo.com>"
  },

  "secrets": {
    "required": [
      "SHOPIFY_CLIENT_ID",
      "SHOPIFY_CLIENT_SECRET",
      "RESEND_API_KEY"
    ]
  },

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  }
}